NODE_ENV=development
PORT=3000
POSTGRES_PORT=5432
POSTGRES_DB=auth_api
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_api
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
TRUST_PROXY=0
DOCS_ENABLED=true
READINESS_TIMEOUT_MS=2000
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://node-express-auth-api

# Required only when running `npm run db:seed`.
ADMIN_SEED_NAME=Administrator
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-a-unique-password-at-least-12-characters
