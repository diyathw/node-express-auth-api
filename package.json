{
  "name": "node-express-auth-api",
  "version": "1.0.0",
  "description": "TypeScript Express authentication API with PostgreSQL, Prisma, Scalar, and ReDoc",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit && tsc --project tsconfig.test.json",
    "lint": "eslint src tests prisma.config.ts",
    "lint:fix": "eslint src tests prisma.config.ts --fix",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "prepare": "husky",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "admin:bootstrap": "tsx src/scripts/bootstrap-admin.ts",
    "docker:db": "docker compose up -d postgres",
    "docker:dev": "docker compose --profile dev up --build",
    "docker:app": "docker compose --profile app up --build -d",
    "docker:down": "docker compose down",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": "^20.2.0 || ^22.1.0 || ^24.0.0",
    "npm": ">=10"
  },
  "keywords": [
    "express",
    "typescript",
    "authentication",
    "postgresql",
    "prisma",
    "openapi",
    "scalar",
    "redoc",
    "jwt"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@scalar/express-api-reference": "^0.10.11",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-oauth2-jwt-bearer": "^1.9.1",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "redoc": "2.5.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.5",
    "babel-jest": "^30.4.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "prisma": "^7.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "glob": "13.0.6",
    "minimatch": "10.2.5",
    "test-exclude": "8.0.0"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true
  }
}
